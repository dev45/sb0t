<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>core</RootNamespace>
    <AssemblyName>core</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CS1591;SYSLIB0014</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\iconnect\iconnect.csproj" />
    <ProjectReference Include="..\captcha\captcha.csproj" />
    <ProjectReference Include="..\commands\commands.csproj" />
    <ProjectReference Include="..\scripting\scripting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Libraries\dictionary.aff" Link="dictionary.aff" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Libraries\dictionary.dic" Link="dictionary.dic" CopyToOutputDirectory="PreserveNewest" />
    <None Update="servers.dat" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DnsClient" Version="1.8.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="2.88.9" />
    <PackageReference Include="WeCantSpell.Hunspell" Version="7.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Archivos que el proyecto original no compilaba -->
    <Compile Remove="Linking\TrustedLeafItem.cs" />
    <Compile Remove="Linking\TrustedLeavesManager.cs" />
    <Compile Remove="LinkHub\LeafProcessor.cs" />
  </ItemGroup>

</Project>